server {
  listen 80;
  server_name _;
  server_tokens off;

  root /usr/share/nginx/html;
  index index.html;

  gzip on;
  gzip_types text/css application/javascript application/json image/svg+xml;

  # API REST: gateway del backend (BACKEND_URL, por ejemplo http://host.docker.internal:8080).
  location /api/ {
    proxy_pass ${BACKEND_URL};
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_read_timeout 30s;
  }
  location /auth/ {
    proxy_pass ${BACKEND_URL};
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_read_timeout 30s;
  }

  # Proxy de MangaDex (lector de avances y editor de memes). La barra final del proxy_pass quita el prefijo /mdx.
  location /mdx/ {
    proxy_pass http://mdx:3000/;
    proxy_read_timeout 30s;
  }

  # Archivos con hash en el nombre: caché larga.
  location /assets/ {
    expires 30d;
    add_header Cache-Control "public, immutable";
  }

  # Rutas de la aplicación de una sola página.
  location / {
    try_files $uri $uri/ /index.html;
  }
}
